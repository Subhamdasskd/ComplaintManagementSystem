# ---------------------------------------------------------------------------
# Complaint Management System - environment
# Copy to .env.local (or set these in the Vercel dashboard) and fill in values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local:  postgresql://postgres:password@localhost:5432/cms
# Neon:   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/cms?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cms?schema=public"

# 32+ byte secret used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional: protects /api/cron/escalate so only Vercel Cron (or you) can run it.
CRON_SECRET="replace-me-too"

# Optional: shown in the UI footer and seed data.
NEXT_PUBLIC_APP_NAME="Complaint Management System"

# Seed the demo accounts with this password (defaults to Demo@12345 when unset).
SEED_DEMO_PASSWORD="Demo@12345"
