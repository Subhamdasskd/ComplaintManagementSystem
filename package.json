{
  "name": "complaint-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Complaint Management System - role-based grievance handling with SLA tracking, automatic escalation and live analytics",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
